{
  "name": "@voice-agent/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API: voice gateway, agent runtime, hybrid RAG, tools",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts --runInBand --forceExit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register scripts/migrate.ts",
    "db:seed": "node -r @swc-node/register scripts/seed-knowledge.ts",
    "eval:retrieval": "node -r @swc-node/register scripts/eval-retrieval.ts",
    "bench:speech": "node -r @swc-node/register scripts/bench-speech.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@voice-agent/contracts": "workspace:*",
    "bullmq": "^6.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "gpt-tokenizer": "^4.1.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.4.1",
    "mathjs": "^15.2.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.6.0",
    "openai": "^7.54.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.9",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.2",
    "@voice-agent/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.30.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  }
}
