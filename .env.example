# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ───────── Infrastructure (matches docker/docker-compose.yml) ─────────
DATABASE_URL=postgres://postgres:postgres@localhost:5434/voice_agent
REDIS_URL=redis://localhost:6379
DB_MIGRATE_ON_START=true

# ───────── AI providers ─────────
# openai | mock. Leave empty to auto-select: openai when OPENAI_API_KEY is set, otherwise mock.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ───────── Agent / retrieval tuning ─────────
RERANK_ENABLED=false
AGENT_MAX_STEPS=6
RETRIEVAL_TOP_K=5

# ───────── Web ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000
