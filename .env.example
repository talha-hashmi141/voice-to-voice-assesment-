# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ───────── Infrastructure (matches docker/docker-compose.yml) ─────────
DATABASE_URL=postgres://postgres:postgres@localhost:5434/voice_agent
REDIS_URL=redis://localhost:6379
DB_MIGRATE_ON_START=true

# ───────── AI providers ─────────
# openai | mock. Leave empty to auto-select: openai when OPENAI_API_KEY is set, otherwise mock.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# gpt-4o-transcribe answered ~2x faster than gpt-4o-mini-transcribe in our benchmark for +$0.003/min.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ───────── Agent / retrieval tuning ─────────
RERANK_ENABLED=false
AGENT_MAX_STEPS=6
# Caps each model reply (voice answers are short); also caps spend per turn.
AGENT_MAX_OUTPUT_TOKENS=400
# Pre-fetch passages for each message before the first model call: simple questions finish in one round.
AGENT_EAGER_RETRIEVAL=true
RETRIEVAL_TOP_K=5
# Weight of the keyword (BM25) channel relative to the embedding channel in rank fusion.
RETRIEVAL_SPARSE_WEIGHT=0.7

# ───────── Web ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000
