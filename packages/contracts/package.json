{
  "name": "@voice-agent/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth: Zod schemas, DTO types, socket event contracts and tool schemas shared by the API and the web app",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@voice-agent/config": "workspace:*",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
